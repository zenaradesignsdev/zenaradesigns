# Environment Variables for Zenara Designs
# Copy this file to .env.local and fill in your actual values

# Resend API Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CORS Configuration
# The allowed origin for API requests (your production domain)
ALLOWED_ORIGIN=https://zenaradesigns.com

# Optional: Development overrides
# For local development, you might want to use:
# ALLOWED_ORIGIN=http://localhost:5173

# ─── Google Search Console (scripts/gsc/gsc, scripts/gsc-audit.js) ───────────
# No credentials needed here: both tools authenticate keylessly through your gcloud login
# (admin account -> impersonated service account). Service-account
# JSON keys are blocked by org policy — don't create one. See scripts/GSC_SETUP.md.
#
# Optional overrides (defaults are Zenara's admin account / GSC service account):
# ZENARA_GCLOUD_ACCOUNT=
# ZENARA_GSC_SERVICE_ACCOUNT=
#
# Optional overrides for npm run gsc-audit:
# GSC_SITE_URL=sc-domain:zenaradesigns.com  # default
# GSC_OUTPUT_FILE=gsc-audit-report.md       # Output filename (default: gsc-audit-report.md)
# GSC_MAX_URLS=100                          # Max URLs to inspect individually (default: 100)
# GSC_DAYS=28                               # Days of analytics history to pull (default: 28)

# ─── PageSpeed Insights Audit (scripts/pagespeed-audit.js) ───────────────────
PSI_URL=https://zenaradesigns.com
PSI_API_KEY=your_google_api_key_here
# PSI_STRATEGY=both         # mobile | desktop | both (default: both)
# PSI_OUTPUT_FILE=pagespeed-audit-report.md
